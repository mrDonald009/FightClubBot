# Обычно копируют в .env. Для тестового бота: скопируйте в .env.dev и запускайте с
#   ENV_FILE=.env.dev python bot.py
# (или задайте ENV_FILE в systemd/docker для второго инстанса).
BOT_TOKEN=your_bot_token_here
# Telegram ID администратора (меню админа, рассылка аудита и т.д.).
# Пусто или строка отсутствует — админ при старте не создаётся.
ADMIN_TELEGRAM_ID=26655492

# --- Тренеры (единый стиль): все id через запятую + один вид спорта для всех ---
# COACH_TELEGRAM_IDS=416035374,26655492
# COACH_DEFAULT_SPORT_TYPE=Тайский Бокс

# Кого брать шаблоном при «добавить спортсмена» под админом (календарь/слоты).
# Не задано — берётся устар. THAI_COACH_TELEGRAM_ID, если есть, иначе первый id из COACH_TELEGRAM_IDS.
# ADMIN_DELEGATE_COACH_TELEGRAM_ID=416035374

# Устарело: если задан и id нет в COACH_TELEGRAM_IDS, он добавляется в начало списка при старте.
# Можно оставить пустым, когда все тренеры уже в COACH_TELEGRAM_IDS.
# THAI_COACH_TELEGRAM_ID=

DATABASE_URL=sqlite:///database/club.db

# Временная зона приложения (IANA), например Europe/Moscow
APP_TIMEZONE=Europe/Moscow

# Длительность тренировки в минутах (используется для определения "тренировка завершена")
TRAINING_DURATION_MINUTES=90

# Запас после времени начала тренировки (мин): выбор даты первой тренировки / начало заморозки
# ещё считается допустимым, пока now <= начало + этот запас
ACTIVATION_GRACE_AFTER_START_MINUTES=30
